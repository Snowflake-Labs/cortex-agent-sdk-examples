# Required: Your Snowflake account identifier (e.g. "xy12345.us-east-1")
SNOWFLAKE_ACCOUNT=

# Required: A Snowflake Programmatic Access Token
SNOWFLAKE_PAT=

# Optional: Database and schema for agent CRUD examples
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC

# Optional: Warehouse for analyst tool execution
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Optional: Fully-qualified semantic view for analyst examples
# (e.g. "MY_DB.MY_SCHEMA.MY_SEMANTIC_VIEW")
SNOWFLAKE_SEMANTIC_VIEW=

# Optional: Fully-qualified Cortex Search service for search examples
# (e.g. "MY_DB.MY_SCHEMA.MY_SEARCH_SERVICE")
SNOWFLAKE_SEARCH_SERVICE=

# Optional: Fully-qualified workspace for coding agent examples
# (e.g. "USER$MY_USER.PUBLIC.DEFAULT$")
SNOWFLAKE_WORKSPACE=

# Optional: Fully-qualified MCP SERVER for MCP examples
# (e.g. "MY_DB.MY_SCHEMA.MY_MCP_SERVER")
SNOWFLAKE_MCP_SERVER=

# Optional: Explicit Snowflake endpoint (regional, PrivateLink, or proxy)
# SNOWFLAKE_BASE_URL=https://myaccount.snowflakecomputing.com

# Optional: Snowflake connection profile name (for session-token auth examples)
CORTEX_EXAMPLE_CONNECTION=default
